{
  "manifest_version": 3,
  "name": "Higgsfield Queue Companion",
  "description": "Queue Higgsfield video prompts and feed them through the normal web UI one at a time.",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://higgsfield.ai/*",
    "https://*.higgsfield.ai/*"
  ],
  "action": {
    "default_title": "Open Higgsfield Queue"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://higgsfield.ai/*",
        "https://*.higgsfield.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}